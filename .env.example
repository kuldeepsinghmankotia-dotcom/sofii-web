NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
TAVILY_API_KEY=
# Optional. Sarvam AI — Indic speech models (Saaras STT, Bulbul TTS).
# Without it, speech falls back to Whisper and Groq/ElevenLabs, and the
# Indian languages ElevenLabs does not cover (Bengali, Telugu, Kannada,
# Malayalam, Gujarati, Punjabi, Odia, Marathi) use the browser's own voice.
# Get one at https://dashboard.sarvam.ai — new accounts include free credits.
SARVAM_API_KEY=
# Optional. WhatsApp Cloud API (Meta). Without these the webhook returns 404
# and the channel is simply off. See docs/whatsapp-setup.md.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
