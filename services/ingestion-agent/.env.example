GEMINI_API_KEY=replace-with-gemini-api-key
DOCUMENT_UPLOADS_BUCKET=document-uploads

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_VISION_MODEL=qwen2.5vl:7b
GROQ_API_KEY=replace-with-groq-api-key
